<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="FileHandling.Properties" GeneratedClassName="Settings">
  <Profiles />
  <Settings>
    <Setting Name="FromEmail" Type="System.String" Scope="User">
      <Value Profile="(Default)">YOUR_FROM_EMAIL@example.com</Value>
    </Setting>
    <Setting Name="DeveloperEmail" Type="System.String" Scope="User">
      <Value Profile="(Default)">YOUR_DEVELOPER_EMAIL@example.com</Value>
    </Setting>
    <Setting Name="GroupEmail" Type="System.String" Scope="User">
      <Value Profile="(Default)">YOUR_GROUP_EMAIL@example.com</Value>
    </Setting>
    <Setting Name="SMTPHost" Type="System.String" Scope="User">
      <Value Profile="(Default)">YOUR_SMTP_HOST</Value>
    </Setting>
  </Settings>
</SettingsFile>