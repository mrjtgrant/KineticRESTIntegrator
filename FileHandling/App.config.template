			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<userSettings>
		<FileHandling.Properties.Settings>
			<!-- ============================================================
			     FileHandling settings — email / SMTP

			     SETUP:
			       1. Copy this file to App.config (same folder).
			       2. Replace the YOUR_* values below.
			       3. App.config is gitignored — your values stay local.

			     OVERRIDE AT RUNTIME (optional):
			       Any setting can be overridden by an environment variable
			       of the same name with a SMTP_ or EMAIL_ prefix. Useful
			       for CI and production deployment.
			     ============================================================ -->

			<!-- Email address used as the default "From:" on outbound mail.
			     Often a no-reply or service mailbox. -->
			<setting name="FromEmail" serializeAs="String">
				<value>YOUR_FROM_EMAIL@example.com</value>
			</setting>

			<!-- Single developer email address used in two cases:
			       1. As the default BCC on every outbound email (audit trail).
			       2. As the ONLY recipient when EmailSpecs.IsDebug = true.
			     Set this to your own address so test runs don't email customers. -->
			<setting name="DeveloperEmail" serializeAs="String">
				<value>YOUR_DEVELOPER_EMAIL@example.com</value>
			</setting>

			<!-- Optional broader distribution list (e.g. a team alias).
			     Currently unreferenced in code; reserved for future use.
			     Safe to leave as the placeholder. -->
			<setting name="GroupEmail" serializeAs="String">
				<value>YOUR_GROUP_EMAIL@example.com</value>
			</setting>

			<!-- SMTP relay host or IP address.
			     Examples:
			       smtp.example.com
			       mail.internal.example.com
			       10.0.0.25
			     For the default configuration (anonymous relay on
			     port 25 with no TLS), set this and leave the four
			     SMTP* settings below at their defaults. -->
			<setting name="SMTPHost" serializeAs="String">
				<value>YOUR_SMTP_HOST</value>
			</setting>

			<!-- SMTP port. Default is 25 (anonymous relay convention).
			     Modern setups use 587 (STARTTLS with auth). -->
			<setting name="SMTPPort" serializeAs="String">
				<value>25</value>
			</setting>

			<!-- Enable TLS for the SMTP connection.
			     - False (default): plain connection, no TLS - required
			       for legacy anonymous port-25 relays.
			     - True: STARTTLS - connect plain, upgrade to TLS. Use
			       port 587 (the modern STARTTLS convention).
			     Misconfigurations rejected with a clear error in
			     EmailSpecs.EmailError:
			     - Port 25 + SMTPEnableSsl=True (port 25 is plain-text)
			     - Port 465 + SMTPEnableSsl=True (implicit TLS is not
			       supported by this library - use port 587 instead). -->
			<setting name="SMTPEnableSsl" serializeAs="String">
				<value>False</value>
			</setting>

			<!-- SMTP authentication username. Leave empty for anonymous
			     relays. When set, the connection authenticates with
			     SMTPUsername / SMTPPassword. -->
			<setting name="SMTPUsername" serializeAs="String">
				<value />
			</setting>

			<!-- SMTP authentication password.
			     WARNING: stored in plain text in App.config. For
			     production deployments, prefer the environment-variable
			     override mechanism (SMTP_ prefix) or another secure
			     credential store rather than committing a password
			     into a config file on disk. -->
			<setting name="SMTPPassword" serializeAs="String">
				<value />
			</setting>
		</FileHandling.Properties.Settings>
	</userSettings>
</configuration>