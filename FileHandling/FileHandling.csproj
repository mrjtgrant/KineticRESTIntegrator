<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>FileHandling</RootNamespace>
    <AssemblyName>FileHandling</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>FileHandling</Product>
    <AssemblyTitle>FileHandling</AssemblyTitle>
    <Description>Excel generation (ClosedXML), CSV writer, and SMTP email helpers for the Kinetic REST Integrator.</Description>
    <Company></Company>
	<Copyright>Copyright © 2025-2026 Justin Grant</Copyright>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>

    <!-- Keep the original ProjectGuid so the .sln reference still resolves -->
    <ProjectGuid>{FB7502DF-C1CE-4F76-8B28-B68035F8A7FE}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Build-warning suppression.
       MSB3277 fires on net48 because ClosedXML (a netstandard2.0 library)
       transitively references newer versions of System.Memory, System.Buffers,
       System.Numerics.Vectors, and System.Runtime.CompilerServices.Unsafe than
       the .NET Framework 4.8 facade assemblies provide. App.config's
       <bindingRedirect> entries resolve this at runtime — the warning is a
       build-time complaint about a state that is deliberately handled.
       MSB3836 fires on net8.0 because <AutoGenerateBindingRedirects> produces
       its own redirects that overlap with the hand-coded ones in App.config
       (which are there for the net48 runtime path). Same underlying root
       cause; same "already handled, please stop complaining" character.
       Both suppressed here rather than papered over with a more invasive fix
       that risks changing the runtime binding behavior App.config provides. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3277;MSB3836</NoWarn>
  </PropertyGroup>

  <!-- For net8.0 only: copy transitive NuGet package DLLs (ClosedXML,
       MailKit, Newtonsoft.Json, and their transitives) into the output
       folder. Default for library projects is to NOT copy them (consumers
       resolve NuGet themselves), but this library is consumed by projects
       that reference its DLLs directly from a local lib/ folder rather than
       via NuGet — so the DLLs need to be alongside the library's own output.
       Not applied to net48 to avoid disturbing the existing binding-redirect
       and BCL-facade-conflict handling on that target. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- MailKit 4.16.0+ for SMTP on .NET 6+. The net48 build uses
       System.Net.Mail.SmtpClient (BCL) instead - MailKit 4.x dropped
       .NET Framework support, and the only net48-compatible MailKit (3.x)
       has an unpatched STARTTLS-Response-Injection CVE (GHSA-9j88-vvj5-vhgr).
       Using System.Net.Mail on net48 avoids that CVE entirely. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="MailKit" Version="4.16.0" />
  </ItemGroup>

</Project>
