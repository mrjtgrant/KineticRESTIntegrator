<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>KeriConfigurator</RootNamespace>
    <AssemblyName>KeriConfigurator</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>KeriConfigurator</Product>
    <AssemblyTitle>KeriConfigurator</AssemblyTitle>
    <Description>Composition root and interactive onboarding tool for the Kinetic REST Integrator: owns the unified configuration schema, builds sessions and clients, and verifies connectivity.</Description>
    <Company></Company>
    <Copyright>Copyright (c) 2025-2026 Justin Grant</Copyright>

    <!-- Initial version, aligned with the coordinated 0.3.0 release - see CHANGELOG. -->
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>

    <!-- Keep a stable ProjectGuid so the .sln reference resolves. -->
    <ProjectGuid>{3AD2BFD9-D816-4648-9F91-F0B31CD8D172}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Build-warning suppression - same handled-binding-redirect cause as
       FileHandling: this project pulls in FileHandling's transitive closure
       (ClosedXML, MailKit, and friends). MSB3277 (net48 BCL-facade conflict)
       and MSB3836 (net8 overlapping redirects) are resolved by binding
       redirects / AutoGenerateBindingRedirects; the warnings are noise. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3277;MSB3836</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RESTServices\RESTServices.csproj" />
    <ProjectReference Include="..\EpicorSvcs\EpicorSvcs.csproj" />
    <ProjectReference Include="..\FileHandling\FileHandling.csproj" />
  </ItemGroup>

  <!-- System.Configuration.ConfigurationManager: makes Properties.Settings.Default.X
       and App.config loading work on .NET 8, matching the built-in
       System.Configuration assembly on .NET Framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <!-- System.Xml.Linq (XDocument) is used by the onboarding console to update
       App.config. It is part of the default .NET Framework reference set, but is
       named explicitly here for net48 to be safe (this is the only project that
       uses it). On net8 it ships in the shared framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Auto-create App.config from App.config.template on first build. This is
       the one place in the solution that materializes config: KeriConfigurator
       owns the unified settings section, and the consumer exes share this
       App.config via <AppConfig> (wired in Step 3). The guard copies only when
       App.config doesn't exist yet, so filled-in values are never overwritten.
       Build fails once with a clear message after seeding, then succeeds once
       edited (or once the onboarding console has written values). -->
  <Target Name="CreateAppConfigFromTemplate" BeforeTargets="PrepareForBuild" Condition="!Exists('App.config') And Exists('App.config.template')">
    <Copy SourceFiles="App.config.template" DestinationFiles="App.config" />
    <Message Importance="high" Text="*** Created App.config from App.config.template. Edit it (or run KeriConfigurator) to set your values, then rebuild. ***" />
    <Error Text="App.config was just created from template. Set your values before continuing." />
  </Target>

</Project>
