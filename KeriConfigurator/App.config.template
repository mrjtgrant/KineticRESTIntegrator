<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="KeriConfigurator.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<userSettings>
		<!-- ================================================================
		     The single config template for the whole solution. KeriConfigurator
		     owns this; the consumer executables share it via <AppConfig>.

		     SETUP (local development):
		       Run KeriConfigurator and follow the prompts, OR:
		       1. Copy this file to App.config (same folder).
		       2. Fill in the YOUR_* values below.
		       3. App.config is gitignored - your values stay local; this
		          template stays in source control and is never edited with
		          real values.

		     LIVE / DEPLOYED:
		       Any value below may be an environment-variable reference instead
		       of a literal, written as {ENV:NAME}. For example, a DefaultApiKey
		       value of {ENV:EPICOR_API_KEY} reads the EPICOR_API_KEY variable
		       from the environment at runtime - the reference stays in this file
		       (self-documenting), the secret itself stays off disk. A literal
		       value is used as-is; the environment is read only where a value is
		       an {ENV:...} reference. Run KeriConfigurator and choose [E] on a
		       secret to write one of these for you. For credential brokering
		       (web portal, Windows Credential Manager), build an
		       EpicorRESTSessionKey in code - see CONFIGURATION.md.
		     ================================================================ -->

		<KeriConfigurator.Properties.Settings>

			<!-- ===== Epicor REST connection ===== -->

			<!-- Epicor user with REST access. A service account is recommended
			     over a personal account. -->
			<setting name="DefaultUser" serializeAs="String">
				<value>YOUR_EPICOR_USERNAME</value>
			</setting>

			<!-- Password for DefaultUser (HTTP Basic auth).
			     Live: reference a variable instead of a literal, e.g.
			     <value>{ENV:EPICOR_PASSWORD}</value> -->
			<setting name="DefaultPasskey" serializeAs="String">
				<value>YOUR_EPICOR_PASSWORD</value>
			</setting>

			<!-- Epicor Company ID, e.g. "EPIC01". Matches Company.Company in Epicor. -->
			<setting name="DefaultCompany" serializeAs="String">
				<value>YOUR_COMPANY_ID</value>
			</setting>

			<!-- Full base URL of your Epicor app server, no trailing slash -
			     copied verbatim from the Epicor client's address bar, e.g.
			     https://yourcompany-pilot.epicorsaas.com/server
			     For multiple environments, build an EpicorRESTSessionKey per
			     environment in code (see CONFIGURATION.md) - config holds one. -->
			<setting name="DefaultBaseUrl" serializeAs="String">
				<value>YOUR_EPICOR_BASE_URL</value>
			</setting>

			<!-- Optional API key. Its presence alone selects the URL shape: unset
			     = v1 (Basic), set = v2 OData. Independent of Basic auth - set this
			     and DefaultUser/DefaultPasskey together if your Epicor needs both.
			     Live: reference a variable instead of a literal, e.g.
			     <value>{ENV:EPICOR_API_KEY}</value> -->
			<setting name="DefaultApiKey" serializeAs="String">
				<value>YOUR_EPICOR_APIKEY</value>
			</setting>

			<!-- ===== Email / SMTP ===== -->

			<!-- Default "From:" on outbound mail. Often a no-reply or service mailbox. -->
			<setting name="FromEmail" serializeAs="String">
				<value>YOUR_FROM_EMAIL@example.com</value>
			</setting>

			<!-- Developer address: default BCC on every send (audit trail), and the
			     ONLY recipient when EmailSpecs.IsDebug = true. Set to your own
			     address so test runs don't email customers. -->
			<setting name="DeveloperEmail" serializeAs="String">
				<value>YOUR_DEVELOPER_EMAIL@example.com</value>
			</setting>

			<!-- Optional broader distribution list. Reserved for future use;
			     safe to leave as the placeholder. -->
			<setting name="GroupEmail" serializeAs="String">
				<value>YOUR_GROUP_EMAIL@example.com</value>
			</setting>

			<!-- SMTP relay host or IP (e.g. smtp.example.com, 10.0.0.25). For the
			     default anonymous relay on port 25 with no TLS, set this and leave
			     the four SMTP* settings below at their defaults. -->
			<setting name="SMTPHost" serializeAs="String">
				<value>YOUR_SMTP_HOST</value>
			</setting>

			<!-- SMTP port. Default 25 (anonymous relay). Modern setups use 587
			     (STARTTLS with auth). -->
			<setting name="SMTPPort" serializeAs="String">
				<value>25</value>
			</setting>

			<!-- TLS for the SMTP connection.
			       False (default): plain, no TLS - legacy anonymous port-25 relays.
			       True: STARTTLS - connect plain, upgrade to TLS (use port 587).
			     Rejected with a clear EmailError: port 25 + True, or port 465 + True
			     (implicit TLS unsupported - use 587 + STARTTLS). -->
			<setting name="SMTPEnableSsl" serializeAs="String">
				<value>False</value>
			</setting>

			<!-- SMTP auth username. Empty = anonymous relay. When set, the
			     connection authenticates with SMTPUsername / SMTPPassword. -->
			<setting name="SMTPUsername" serializeAs="String">
				<value />
			</setting>

			<!-- SMTP auth password. WARNING: a literal here is plain text on disk.
			     Live: reference a variable instead of a literal, e.g.
			     <value>{ENV:SMTP_PASSWORD}</value>
			     (or prefer a secure store; see CONFIGURATION.md). -->
			<setting name="SMTPPassword" serializeAs="String">
				<value />
			</setting>

		</KeriConfigurator.Properties.Settings>
	</userSettings>
</configuration>
