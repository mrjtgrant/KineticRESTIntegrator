<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="EpicorSvcs.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
	</startup>
	<userSettings>
		<EpicorSvcs.Properties.Settings>
			<!-- ============================================================
           Epicor REST connection settings
           Copy this file to App.config and fill in your values.
           Do NOT commit App.config — it is gitignored.
           ============================================================ -->

			<!-- Epicor user with REST access. Service accounts are recommended
           over personal accounts. -->
			<setting name="DefaultUser" serializeAs="String">
				<value>YOUR_EPICOR_USERNAME</value>
			</setting>

			<!-- Password for DefaultUser. If using API-key auth (v2 OData),
           leave this blank and set ApiKey on RESTAuthenticationObject. -->
			<setting name="DefaultPasskey" serializeAs="String">
				<value>YOUR_EPICOR_PASSWORD</value>
			</setting>

			<!-- Epicor Company ID, e.g. "EPIC01". Matches Company.Company in Epicor. -->
			<setting name="DefaultCompany" serializeAs="String">
				<value>YOUR_COMPANY_ID</value>
			</setting>

			<!-- Which environment to use by default when no env is passed to a
           service constructor. Valid values: "prod" / "live", "pilot",
           "test" / "third", or any literal URL. -->
			<setting name="DefaultEnvironment" serializeAs="String">
				<value>pilot</value>
			</setting>

			<!-- Full base URL for each environment, no trailing slash. -->
			<setting name="EnvLive" serializeAs="String">
				<value>https://erp-live.example.com/server</value>
			</setting>
			<setting name="EnvPilot" serializeAs="String">
				<value>https://erp-pilot.example.com/server</value>
			</setting>
			<setting name="EnvTest" serializeAs="String">
				<value>https://erp-dev.example.com/server</value>
			</setting>
		</EpicorSvcs.Properties.Settings>
	</userSettings>
</configuration>