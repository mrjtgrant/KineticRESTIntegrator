<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>EpicorSvcs</RootNamespace>
    <AssemblyName>EpicorSvcs</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>EpicorSvcs</Product>
    <AssemblyTitle>EpicorSvcs</AssemblyTitle>
    <Description>Strongly typed C# wrappers for Epicor Kinetic Business Objects (BOs) and Business Activity Queries (BAQs). Built on RESTServices.</Description>
    <Company></Company>
	<Copyright>Copyright © 2025-2026 Justin Grant</Copyright>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>

    <!-- Keep the original ProjectGuid so the .sln reference still resolves -->
    <ProjectGuid>{B3F0BB2A-2325-4177-A8E0-462A86FBBB66}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- For net8.0 only: copy transitive NuGet package DLLs into the output
       folder. Default for library projects is to NOT copy them (consumers
       resolve NuGet themselves), but this library is consumed by projects
       that reference its DLLs directly from a local lib/ folder rather than
       via NuGet — so the DLLs need to be alongside the library's own output.
       Not applied to net48 to avoid disturbing the existing binding-redirect
       and BCL-facade-conflict handling on that target. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Test access: lets KineticRESTIntegrator.Tests see internal types
       (notably UDTableMapping<T>) without making them part of the
       public API. Mirrors the same configuration in RESTServices.csproj. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KineticRESTIntegrator.Tests" />
  </ItemGroup>

  <!-- Microsoft.CSharp is required on .NET Framework to enable `dynamic`
       typing support. On .NET 6+, `dynamic` works without this reference. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- System.Configuration.ConfigurationManager: makes `Properties.Settings.Default.X`
       and App.config file loading work on .NET 6+, matching the behavior provided
       by the built-in System.Configuration assembly on .NET Framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RESTServices\RESTServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Auto-create App.config from App.config.template on first build.
       Build will fail once with a clear message telling the developer to
       fill in their settings, then succeed on subsequent builds. -->
  <Target Name="CreateAppConfigFromTemplate" BeforeTargets="PrepareForBuild" Condition="!Exists('App.config') And Exists('App.config.template')">
    <Copy SourceFiles="App.config.template" DestinationFiles="App.config" />
    <Message Importance="high" Text="*** Created App.config from App.config.template. Edit it with your settings, then rebuild. ***" />
    <Error Text="App.config was just created from template. Edit it with your settings before continuing." />
  </Target>

  <!-- Optional local-only extensions. Local.targets is gitignored — see
       Local.targets.template in this folder for the shape and usage. -->
  <Import Project="$(MSBuildThisFileDirectory)Local.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)Local.targets')" />

</Project>
