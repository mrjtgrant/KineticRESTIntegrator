<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EpicorSvcDemo</RootNamespace>
    <AssemblyName>EpicorSvcDemo</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>EpicorSvcDemo</Product>
    <AssemblyTitle>EpicorSvcDemo</AssemblyTitle>
    <Description>End-to-end example of the Kinetic REST Integrator: runs a BAQ, builds an Excel report, and emails it.</Description>
    <Company></Company>
    <Copyright></Copyright>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Keep the original ProjectGuid so the .sln reference still resolves -->
    <ProjectGuid>{1E3836B0-940C-4E6F-813D-9F447FB47C0D}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- App manifest -->
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EpicorSvcs\EpicorSvcs.csproj" />
    <ProjectReference Include="..\FileHandling\FileHandling.csproj" />
    <ProjectReference Include="..\RESTServices\RESTServices.csproj" />
  </ItemGroup>

  <!-- Ship the demo BAQ alongside the executable so the program can locate it
       (via AppContext.BaseDirectory) and offer it for import. The SDK already
       globs it as a None item; this only adds the copy-to-output behavior. -->
  <ItemGroup>
    <None Update="Parts_BAQ.baq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Auto-create App.config from App.config.template on first build. This is
       the one place in the solution that materializes config: the demo is the
       startup project, so its App.config is the only one read at runtime (it
       carries both the EpicorSvcs and FileHandling settings sections). The
       guard copies only when App.config doesn't yet exist, so a developer's
       filled-in values are never overwritten by a later build. The build fails
       once with a clear message after seeding, then succeeds once edited. -->
  <Target Name="CreateAppConfigFromTemplate" BeforeTargets="PrepareForBuild" Condition="!Exists('App.config') And Exists('App.config.template')">
    <Copy SourceFiles="App.config.template" DestinationFiles="App.config" />
    <Message Importance="high" Text="*** Created App.config from App.config.template. Edit it with your settings, then rebuild. ***" />
    <Error Text="App.config was just created from template. Edit it with your settings before continuing." />
  </Target>

</Project>
