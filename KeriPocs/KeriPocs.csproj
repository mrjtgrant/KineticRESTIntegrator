<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>KeriPocs</RootNamespace>
    <AssemblyName>KeriPocs</AssemblyName>

    <!-- Not a package. The dotted Keri.* names are the four libraries that go
         on NuGet; this is in-solution tooling. Without this a solution-wide
         dotnet pack would emit a package for it anyway. -->
    <IsPackable>false</IsPackable>

    <!-- Consume the solution's single configuration, owned by KeriConfigurator.
         This stamps KeriPocs.exe.config from KeriConfigurator's App.config
         at build time, so the POCs get connection settings without owning any
         config of their own. (KeriConfigurator must be built/configured first;
         its App.config is gitignored and materialized locally.) -->
    <AppConfig>..\KeriConfigurator\App.config</AppConfig>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>KeriPocs</Product>
    <AssemblyTitle>KeriPocs</AssemblyTitle>
    <Description>Runnable examples of the Kinetic REST Integrator — one per major service area. Read operations are always safe; write operations are gated by the KERI_POC_ALLOW_WRITES environment variable.</Description>
    <Copyright></Copyright>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <ComVisible>false</ComVisible>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- System.Net.Http is a built-in assembly on .NET Framework but is not
       auto-referenced by the SDK — needs an explicit Reference. SchemaProbePoc
       uses HttpClient directly, because the schema documents it fetches are
       XML and the transport parses every response as JSON. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- The discovery rules in DtoDiscovery.cs are pure functions and are worth
       testing; the program around them needs a live Epicor server and is not.
       The test project references this one on net48 only, since that is the
       only framework this exe targets. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KineticRESTIntegrator.Tests" Key="$(KeriPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keri.Epicor\Keri.Epicor.csproj" />
    <ProjectReference Include="..\Keri.RestTransport\Keri.RestTransport.csproj" />
    <ProjectReference Include="..\KeriConfigurator\KeriConfigurator.csproj" />
  </ItemGroup>

</Project>
