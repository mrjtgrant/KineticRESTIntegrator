<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Targets:
           net461          .NET Framework 4.6.1 and later (Epicor 10.1 and up)
           netstandard2.0  .NET 5, 6 and 7 — including Kinetic application
                           servers that run on .NET 6
           net8.0          .NET 8 and later -->
    <TargetFrameworks>net461;netstandard2.0;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Keri.Epicor</RootNamespace>
    <AssemblyName>Keri.Epicor</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Keri.Epicor</Product>
    <AssemblyTitle>Keri.Epicor</AssemblyTitle>
    <Description>Keri SDK for Epicor Kinetic: strongly typed C# services over Epicor's Business Objects and Business Activity Queries, with result objects that report which side of the commit boundary a failure landed on. An independent project, not affiliated with Epicor Software Corporation.</Description>
    <Company>Justin Grant</Company>
    <Authors>Justin Grant</Authors>
	<Copyright>Copyright © 2025-2026 Justin Grant</Copyright>
    <Version>0.8.0</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>

    <!-- NuGet package metadata. Without PackageLicenseExpression a packed
         artifact carries no license at all, whatever LICENSE says. -->
    <PackageId>Keri.Epicor</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>epicor;kinetic;erp;rest;odata;bo;baq</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Keep the original ProjectGuid so the .sln reference still resolves -->
    <ProjectGuid>{B3F0BB2A-2325-4177-A8E0-462A86FBBB66}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>

    <!-- Ship the XML doc comments with the package so IntelliSense shows them. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- For net8.0 only: copy transitive NuGet package DLLs into the output
       folder. Default for library projects is to NOT copy them (consumers
       resolve NuGet themselves), but this library is consumed by projects
       that reference its DLLs directly from a local lib/ folder rather than
       via NuGet — so the DLLs need to be alongside the library's own output.
       Not applied to the .NET Framework target to avoid disturbing the existing
       binding-redirect and BCL-facade-conflict handling there. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Test access: lets KineticRESTIntegrator.Tests see internal types
       (notably UDTableMapping<T>) without making them part of the
       public API. Mirrors the same configuration in Keri.RestTransport.csproj. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KineticRESTIntegrator.Tests" />
  </ItemGroup>

  <!-- Microsoft.CSharp is required on .NET Framework to enable `dynamic`
       typing support. On .NET 6+, `dynamic` works without this reference. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keri.RestTransport\Keri.RestTransport.csproj" />
  </ItemGroup>

  <!-- Optional local-only extensions. Local.targets is gitignored — see
       Local.targets.template in this folder for the shape and usage. -->
  <Import Project="$(MSBuildThisFileDirectory)Local.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)Local.targets')" />

  <!-- Reference assemblies for the .NET Framework targets. Without this, the
       build requires the 4.6.1/4.6.2 targeting packs to be installed on the
       machine; with it, any machine that can run the .NET SDK can build every
       Framework target. PrivateAssets="all" keeps it out of consumers' graphs. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shipped inside the package so the gallery page has content. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
