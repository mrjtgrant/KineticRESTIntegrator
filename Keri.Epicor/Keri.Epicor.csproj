<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Keri.Epicor</RootNamespace>
    <AssemblyName>Keri.Epicor</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Keri.Epicor</Product>
    <AssemblyTitle>Keri.Epicor</AssemblyTitle>
    <Description>Strongly typed C# wrappers for Epicor Kinetic Business Objects (BOs) and Business Activity Queries (BAQs). Built on Keri.RestTransport.</Description>
    <Company>Justin Grant</Company>
    <Authors>Justin Grant</Authors>
	<Copyright>Copyright © 2025-2026 Justin Grant</Copyright>
    <Version>0.8.0</Version>
    <AssemblyVersion>0.8.0.0</AssemblyVersion>
    <FileVersion>0.8.0.0</FileVersion>

    <!-- NuGet package metadata. Without PackageLicenseExpression a packed
         artifact carries no license at all, whatever LICENSE says. -->
    <PackageId>Keri.Epicor</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>epicor;kinetic;erp;rest;odata;bo;baq</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Keep the original ProjectGuid so the .sln reference still resolves -->
    <ProjectGuid>{B3F0BB2A-2325-4177-A8E0-462A86FBBB66}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- For net8.0 only: copy transitive NuGet package DLLs into the output
       folder. Default for library projects is to NOT copy them (consumers
       resolve NuGet themselves), but this library is consumed by projects
       that reference its DLLs directly from a local lib/ folder rather than
       via NuGet — so the DLLs need to be alongside the library's own output.
       Not applied to net48 to avoid disturbing the existing binding-redirect
       and BCL-facade-conflict handling on that target. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Test access: lets KineticRESTIntegrator.Tests see internal types
       (notably UDTableMapping<T>) without making them part of the
       public API. Mirrors the same configuration in Keri.RestTransport.csproj. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KineticRESTIntegrator.Tests" />
  </ItemGroup>

  <!-- Microsoft.CSharp is required on .NET Framework to enable `dynamic`
       typing support. On .NET 6+, `dynamic` works without this reference. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keri.RestTransport\Keri.RestTransport.csproj" />
  </ItemGroup>

  <!-- Optional local-only extensions. Local.targets is gitignored — see
       Local.targets.template in this folder for the shape and usage. -->
  <Import Project="$(MSBuildThisFileDirectory)Local.targets"
          Condition="Exists('$(MSBuildThisFileDirectory)Local.targets')" />

  <!-- Shipped inside the package so the gallery page has content. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
