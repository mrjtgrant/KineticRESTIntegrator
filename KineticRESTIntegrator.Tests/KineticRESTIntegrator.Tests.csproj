<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>KineticRESTIntegrator.Tests</RootNamespace>
    <AssemblyName>KineticRESTIntegrator.Tests</AssemblyName>

    <!-- This is a test project, not a shipping library. -->
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>

    <!-- Referencing Keri.Files pulls ClosedXML onto this net48 project, and
         ClosedXML (a netstandard2.0 library) wants newer System.Memory,
         System.Buffers, System.Numerics.Vectors and
         System.Runtime.CompilerServices.Unsafe than the 4.8 facades provide.
         Without these redirects the ClosedXML-backed tests fail at RUNTIME with
         a FileLoadException on assembly version, which reads like a broken test
         rather than a missing binding redirect. Keri.Files.csproj carries the
         same pair for the same reason. MSB3277 is the build-time complaint
         about the state these redirects resolve. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!-- xUnit + the VS / dotnet test runners -->
    <!-- These three packages are the standard xUnit-on-.NET setup:
         - xunit              : the [Fact]/[Theory] attributes and Assert API
         - xunit.runner.visualstudio : lets Visual Studio's Test Explorer and
                                       'dotnet test' discover and run the tests
         - Microsoft.NET.Test.Sdk    : the test host both runners build on -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The tests exercise EpicorSvcs' offline-deterministic surface:
         OperationResult<T>, the OperationResultExtensions, UDRow, and the
         UDTableSvc static legend helpers. No RESTServices reference is needed —
         nothing here touches the transport layer. -->
    <ProjectReference Include="..\EpicorSvcs\EpicorSvcs.csproj" />

    <!-- The file/mail surface: the CSV renderer, the header-map rules,
         FileSpec's computed filename, FileWriter's validation and collision
         handling, and the per-message SMTP resolution. Tests live under Files/.
         Nothing opens a socket — MailKit is net8.0-only in Keri.Mail, so this
         net48 project never sees it. -->
    <ProjectReference Include="..\Keri.Files\Keri.Files.csproj" />
    <ProjectReference Include="..\Keri.Mail\Keri.Mail.csproj" />
  </ItemGroup>

</Project>
