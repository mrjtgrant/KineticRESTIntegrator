<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Keri.Mail</RootNamespace>
    <AssemblyName>Keri.Mail</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Keri.Mail</Product>
    <AssemblyTitle>Keri.Mail</AssemblyTitle>
    <Description>SMTP delivery for the Kinetic REST Integrator: send a report built by Keri.Files, or any file, as an email attachment.</Description>
    <Company>Justin Grant</Company>
    <Authors>Justin Grant</Authors>
	<Copyright>Copyright © 2025-2026 Justin Grant</Copyright>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>

    <!-- NuGet package metadata. Without PackageLicenseExpression a packed
         artifact carries no license at all, whatever LICENSE says. -->
    <PackageId>Keri.Mail</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>smtp;email;mailkit;epicor;kinetic;report</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <ProjectGuid>{57D39385-1A40-435D-847D-DFAEED0FAA7E}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3277;MSB3836</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The only direction this can point. Sending a report means building one
       first, so the mailer depends on the file writer; nothing in Keri.Files
       knows this project exists. Splitting them is what keeps a consumer who
       only writes spreadsheets off the MailKit/MimeKit/BouncyCastle stack and
       its advisories. -->
  <ItemGroup>
    <ProjectReference Include="..\Keri.Files\Keri.Files.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- MailKit 4.16.0+ for SMTP on .NET 6+. The net48 build uses
       System.Net.Mail.SmtpClient (BCL) instead - MailKit 4.x dropped
       .NET Framework support, and the only net48-compatible MailKit (3.x)
       has an unpatched STARTTLS-Response-Injection CVE (GHSA-9j88-vvj5-vhgr).
       Using System.Net.Mail on net48 avoids that CVE entirely. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="MailKit" Version="4.16.0" />
  </ItemGroup>

  <!-- The offline suite reaches ResolveSmtp directly. Making it public purely
       to test it would widen the shipping API; driving it through SendReport
       would mean attempting a real send, which the suite will not do. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KineticRESTIntegrator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Shipped inside the package so the gallery page has content. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
