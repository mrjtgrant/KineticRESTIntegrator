<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Targets:
           net462          .NET Framework 4.6.2 and later — System.Net.Mail
           netstandard2.0  .NET 5, 6 and 7 — MailKit
           net8.0          .NET 8 and later — MailKit
         The Framework floor matches MailKit's lowest .NET Framework build. -->
    <TargetFrameworks>net462;netstandard2.0;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Keri.Mail</RootNamespace>
    <AssemblyName>Keri.Mail</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Keri.Mail</Product>
    <AssemblyTitle>Keri.Mail</AssemblyTitle>
    <Description>SMTP delivery for the Keri SDK: send a report built by Keri.Files, or any file, as an email attachment. Uses MailKit on .NET and System.Net.Mail on .NET Framework.</Description>
    <Company>Justin Grant</Company>
    <Authors>Justin Grant</Authors>
	<Copyright>Copyright © 2025-2026 Justin Grant</Copyright>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>

    <!-- NuGet package metadata. Without PackageLicenseExpression a packed
         artifact carries no license at all, whatever LICENSE says. -->
    <PackageId>Keri.Mail</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>smtp;email;mailkit;epicor;kinetic;report</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <ProjectGuid>{57D39385-1A40-435D-847D-DFAEED0FAA7E}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>

    <!-- Ship the XML doc comments with the package so IntelliSense shows them. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);MSB3277;MSB3836</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The only direction this can point. Sending a report means building one
       first, so the mailer depends on the file writer; nothing in Keri.Files
       knows this project exists. Splitting them is what keeps a consumer who
       only writes spreadsheets off the MailKit/MimeKit/BouncyCastle stack and
       its advisories. -->
  <ItemGroup>
    <ProjectReference Include="..\Keri.Files\Keri.Files.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- MailKit on netstandard2.0 and net8.0. The .NET Framework build uses
       System.Net.Mail from the BCL, which adds no dependencies to a .NET Framework
       consumer. System.Net.Mail supports STARTTLS only, so port 465 (implicit
       TLS) is rejected on every target to keep one configuration valid
       everywhere. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETFramework'">
    <PackageReference Include="MailKit" Version="4.16.0" />
  </ItemGroup>

  <!-- The offline suite reaches ResolveSmtp directly. Making it public purely
       to test it would widen the shipping API; driving it through SendReport
       would mean attempting a real send, which the suite will not do. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>KineticRESTIntegrator.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Reference assemblies for the .NET Framework targets. Without this, the
       build requires the 4.6.1/4.6.2 targeting packs to be installed on the
       machine; with it, any machine that can run the .NET SDK can build every
       Framework target. PrivateAssets="all" keeps it out of consumers' graphs. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shipped inside the package so the gallery page has content. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
