<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EpicorSvcPOCs</RootNamespace>
    <AssemblyName>EpicorSvcPOCs</AssemblyName>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>EpicorSvcPOCs</Product>
    <AssemblyTitle>EpicorSvcPOCs</AssemblyTitle>
    <Description>Runnable examples of the Kinetic REST Integrator — one per major service area. Read operations are always safe; write operations are gated by the KERI_POC_ALLOW_WRITES environment variable.</Description>
    <Copyright></Copyright>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <ComVisible>false</ComVisible>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EpicorSvcs\EpicorSvcs.csproj" />
    <ProjectReference Include="..\RESTServices\RESTServices.csproj" />
  </ItemGroup>

</Project>
