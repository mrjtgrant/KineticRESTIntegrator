<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Targets:
           net461          .NET Framework 4.6.1 and later (Epicor 10.1 and up)
           netstandard2.0  .NET 5, 6 and 7 — including Kinetic application
                           servers that run on .NET 6
           net8.0          .NET 8 and later -->
    <TargetFrameworks>net461;netstandard2.0;net8.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>Keri.RestTransport</RootNamespace>
    <AssemblyName>Keri.RestTransport</AssemblyName>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>Keri.RestTransport</Product>
    <AssemblyTitle>Keri.RestTransport</AssemblyTitle>
    <Description>Transport layer of the Keri SDK: a vendor-agnostic REST client providing session management, authentication (Basic or API key), environment selection, and JSON error handling. Usable on its own; Keri.Epicor builds on it.</Description>
    <Company>Justin Grant</Company>
    <Authors>Justin Grant</Authors>
	<Copyright>Copyright © 2025-2026 Justin Grant</Copyright>
    <Version>1.0.0-rc.2</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- NuGet package metadata. Without PackageLicenseExpression a packed
         artifact carries no license at all, whatever LICENSE says. -->
    <PackageId>Keri.RestTransport</PackageId>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrjtgrant/KineticRESTIntegrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>rest;http;json;client;odata;httpclient</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Keep the original ProjectGuid so the .sln reference still resolves -->
    <ProjectGuid>{FDE58B4C-D608-4412-AB9B-07E91748C174}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>

    <!-- Ship the XML doc comments with the package so IntelliSense shows them. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Debug symbols: pack a .snupkg alongside the .nupkg, with SourceLink
         pointing debuggers at the matching source on GitHub. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!-- Expose internal members (e.g. ResolveApiKeyHeaderName) to the test project. -->
  <ItemGroup>
    <InternalsVisibleTo Include="KineticRESTIntegrator.Tests" Key="$(KeriPublicKey)" />
  </ItemGroup>

  <!-- System.Net.Http is a built-in assembly on .NET Framework but is not
       auto-referenced by the SDK — needs an explicit Reference. On .NET 6+,
       HttpClient is part of the BCL and auto-referenced; no Reference needed. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- Reference assemblies for the .NET Framework targets. Without this, the
       build requires the 4.6.1/4.6.2 targeting packs to be installed on the
       machine; with it, any machine that can run the .NET SDK can build every
       Framework target. PrivateAssets="all" keeps it out of consumers' graphs. -->
  <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shipped inside the package so the gallery page has content. -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
