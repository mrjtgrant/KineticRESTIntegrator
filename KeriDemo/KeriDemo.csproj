<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>KeriDemo</RootNamespace>
    <AssemblyName>KeriDemo</AssemblyName>

    <!-- Not a package. The dotted Keri.* names are the four libraries that go
         on NuGet; this is in-solution tooling. Without this a solution-wide
         dotnet pack would emit a package for it anyway. -->
    <IsPackable>false</IsPackable>

    <!-- Consume the solution's single configuration, owned by KeriConfigurator.
         This stamps KeriDemo.exe.config from KeriConfigurator's App.config
         at build time. The demo no longer owns any config of its own.
         (KeriConfigurator must be built/configured first; its App.config is
         gitignored and materialized locally.) -->
    <AppConfig>..\KeriConfigurator\App.config</AppConfig>

    <!-- Assembly metadata (replaces AssemblyInfo.cs) -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Product>KeriDemo</Product>
    <AssemblyTitle>KeriDemo</AssemblyTitle>
    <Description>End-to-end example of the Kinetic REST Integrator: runs a BAQ, builds an Excel report, and emails it.</Description>
    <Company></Company>
    <Copyright></Copyright>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <!-- Keep the original ProjectGuid so the .sln reference still resolves -->
    <ProjectGuid>{1E3836B0-940C-4E6F-813D-9F447FB47C0D}</ProjectGuid>

    <!-- COM visibility -->
    <ComVisible>false</ComVisible>

    <!-- App manifest -->

    <!-- Misc -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Keri.Epicor\Keri.Epicor.csproj" />
    <ProjectReference Include="..\Keri.Files\Keri.Files.csproj" />
    <ProjectReference Include="..\Keri.Mail\Keri.Mail.csproj" />
    <ProjectReference Include="..\Keri.RestTransport\Keri.RestTransport.csproj" />
    <ProjectReference Include="..\KeriConfigurator\KeriConfigurator.csproj" />
  </ItemGroup>

  <!-- Ship the demo BAQ alongside the executable so the program can locate it
       (via AppContext.BaseDirectory) and offer it for import. The SDK already
       globs it as a None item; this only adds the copy-to-output behavior. -->
  <ItemGroup>
    <None Update="Parts_BAQ.baq">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
