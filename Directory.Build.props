<Project>

  <!-- Applies to every project in the repository. MSBuild imports the nearest
       Directory.Build.props above each project automatically; no project needs
       to reference it.

       STRONG NAMING. A strong-named assembly can only reference other
       strong-named assemblies. Unsigned, Keri is unusable by any consumer whose
       own build signs its output — which some enterprise and ERP-adjacent
       pipelines do by default. All four packages are signed together for the
       same reason: a signed assembly cannot reference an unsigned sibling.

       This is an identity mechanism, not a security one. A signature can be
       stripped and replaced by anyone, and .NET does not treat it as a trust
       boundary; it exists so the runtime can tell one Keri.Epicor from another.
       The key is therefore committed to the repository, so that any contributor
       — and CI — can build it. Do not treat Keri.snk as a secret, and do not
       reuse it for anything that is one.

       Adding or removing a strong name changes assembly identity and breaks
       binding for every existing consumer, which is why this landed before
       1.0.0 rather than after. -->

  <!-- The public half of Keri.snk, needed by every InternalsVisibleTo
       declaration in a signed assembly (CS1726). Derived from the key with
       System.Reflection.StrongNameKeyPair; regenerate it the same way if the
       key is ever replaced, and remember that replacing the key changes
       assembly identity for every consumer. -->

  <!-- WARNINGS. The build is at zero and stays there, enforced on CI rather
       than on every machine. Unconditionally, this property turns a warning a
       newer Roslyn introduces into a build failure for a contributor on code
       they did not write — friction exported to people who did nothing wrong,
       on a repository with no global.json pinning the SDK. Conditioned, CI
       holds the line and a local build only warns.

       ci.yml passes -p:ContinuousIntegrationBuild=true, which is also what
       SourceLink wants for deterministic path mapping, so the two travel
       together. Add the same switch locally to reproduce a CI failure. -->

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <KeriPublicKey></KeriPublicKey>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Keri.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

</Project>
